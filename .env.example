# MedMosa — build-time environment
#
# Copy to `.env.local` for development. Vite only exposes variables prefixed
# with VITE_, and everything here is intended to reach the browser.
#
# NOTHING SECRET BELONGS IN THIS FILE.
# The Supabase service-role key bypasses Row Level Security. It must never be
# added here, committed, or set as a build variable — a static site has no
# server to keep it on, so anything the build can see, a visitor can read.
#
# With these unset the site runs exactly as it does without accounts: all
# courses, topics and questions work, progress is stored locally, and no
# sign-in UI is rendered at all.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Publishable ("anon") key. Safe to ship: it grants nothing on its own, because
# every table is guarded by the Row Level Security policies in
# supabase/migrations/0001_study_progress.sql.
VITE_SUPABASE_ANON_KEY=

# Set to "true" only after Sign in with Apple is fully configured in Supabase
# (Apple Developer Program, Services ID, signing key, verified domain).
# Until then the Apple button is not rendered, so nobody is offered a sign-in
# route that cannot complete.
VITE_AUTH_APPLE_ENABLED=false

# Optional local override for the public Worker API origin. This is a public
# URL, not a credential. The browser automatically uses api.medmosa.org in
# production and http://127.0.0.1:8787 on localhost.
VITE_SOURCE_API_ORIGIN=

# ---------------------------------------------------------------------------
# Cloudflare Worker server-side configuration
# ---------------------------------------------------------------------------
# These names document Worker bindings. For local Worker development, copy the
# values you need to an ignored `.dev.vars` file. In production, keep API keys
# in Cloudflare secrets (`wrangler secret put NAME`), never in a VITE_ variable.

ENABLE_PUBMED=true
NCBI_EMAIL=contact@medmosa.org
NCBI_API_KEY=

ENABLE_OPENALEX=true
OPENALEX_API_KEY=

ENABLE_NLM_TERMINOLOGY=true

ENABLE_OPEN_LIBRARY=true
MEDMOSA_CONTACT_EMAIL=contact@medmosa.org

# No user-facing CDC dataset is configured. Do not enable these until a
# reviewed public-health dataset contract is documented.
ENABLE_CDC_DATA=false
CDC_DATASET_ID=
CDC_DATASET_SOURCE_URL=
