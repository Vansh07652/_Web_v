#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const excluded = new Set(["node_modules", "dist", ".git", "Phase 2"]);
const patterns = [
  /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/,
  /\b(?:sk_live|sk_test)_[A-Za-z0-9]{16,}\b/,
  /\bgh[pousr]_[A-Za-z0-9]{20,}\b/,
  /\bAKIA[0-9A-Z]{16}\b/,
  /\bAIza[0-9A-Za-z_-]{35}\b/,
  /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/,
  /\bnpm_[A-Za-z0-9]{20,}\b/,
  /\b(?:api[_-]?key|client[_-]?secret|access[_-]?token|password)\s*[:=]\s*["'][^"'\r\n]{8,}["']/i,
];
const hits = [];
const walk = (directory) => {
  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    if (entry.isDirectory() && excluded.has(entry.name)) continue;
    const target = path.join(directory, entry.name);
    if (entry.isDirectory()) walk(target);
    else if (entry.name !== "manifest.json" && fs.statSync(target).size < 5_000_000) {
      const source = fs.readFileSync(target, "utf8");
      if (patterns.some((pattern) => pattern.test(source))) hits.push(path.relative(root, target));
    }
  }
};
walk(root);
console.log(`SECRET SCAN: ${hits.length ? "FAIL" : "PASS"}`);
console.log(`Possible secrets: ${hits.length}`);
for (const hit of hits) console.log(`- ${hit}`);
if (hits.length) process.exit(1);
