#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const notes = JSON.parse(fs.readFileSync(path.join(root, "data/notes.json"), "utf8"));
const errors = [];
let references = 0;
for (const note of notes) {
  const notePath = path.join(root, note.filePath);
  const source = fs.readFileSync(notePath, "utf8");
  for (const match of source.matchAll(/!\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g)) {
    const reference = match[1];
    if (/^(?:https?:|data:)/.test(reference)) continue;
    references += 1;
    const target = path.resolve(path.dirname(notePath), decodeURIComponent(reference));
    if (!target.startsWith(root) || !fs.existsSync(target)) errors.push(`${note.filePath}: ${reference}`);
  }
}
for (const directory of ["assets", "public/static-assets", "public/favicon"]) {
  if (!fs.existsSync(path.join(root, directory))) errors.push(`Missing asset directory ${directory}`);
}
console.log(`ASSET VALIDATION: ${errors.length ? "FAIL" : "PASS"}`);
console.log(`Checked ${references} approved local asset references.`);
for (const error of errors) console.log(`- ${error}`);
if (errors.length) process.exit(1);
