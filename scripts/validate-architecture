#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const websiteDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const required = [
  "README.md", "package.json", ".gitignore", "tsconfig.json", "PHASE_3_STATUS.md",
  "architecture/technical-architecture.md", "architecture/information-architecture.md", "architecture/user-flows.md", "architecture/route-map.md", "architecture/component-map.md", "architecture/data-contract.md", "architecture/design-system.md", "architecture/accessibility-plan.md", "architecture/testing-plan.md", "architecture/deployment-plan.md", "architecture/content-update-workflow.md", "architecture/content-source-validation.md", "architecture/future-features.md",
  "architecture/decisions/ADR-001-frontend-stack.md", "architecture/decisions/ADR-002-content-loading.md", "architecture/decisions/ADR-003-routing.md", "architecture/decisions/ADR-004-search-and-filtering.md",
  "src/App.tsx", "src/main.tsx", "src/types/content.ts", "src/lib/content/index.ts", "src/styles/main.css", "src/data/routes.json",
  "scripts/validate-content-source", "scripts/validate-routes", "scripts/validate-architecture", "scripts/validate-build", "scripts/check-links", "scripts/check-assets", "scripts/lint", "scripts/scan-secrets", "scripts/browser-audit.mjs"
];
const errors = [];
for (const relative of required) if (!fs.existsSync(path.join(websiteDir, relative))) errors.push(`Missing ${relative}`);
const packageData = JSON.parse(fs.readFileSync(path.join(websiteDir, "package.json"), "utf8"));
for (const script of ["dev", "build", "test", "test:browser", "typecheck", "lint", "validate:source", "validate:routes", "validate:architecture", "check:links", "check:assets", "scan:secrets", "validate"]) if (!packageData.scripts?.[script]) errors.push(`Missing package script ${script}`);
const sourceFiles = [];
const walk = (directory) => {
  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    const target = path.join(directory, entry.name);
    if (entry.isDirectory()) walk(target); else sourceFiles.push(target);
  }
};
walk(path.join(websiteDir, "src"));
const forbidden = /(?:\/|\.\.\/)(?:raw|working|quarantine|rejected|needs-review)(?:\/|["'])|["']needs-review["']/i;
for (const file of sourceFiles) {
  const content = fs.readFileSync(file, "utf8");
  if (forbidden.test(content)) errors.push(`Source code references unapproved location/status: ${path.relative(websiteDir, file)}`);
}
console.log(`ARCHITECTURE VALIDATION: ${errors.length ? "FAIL" : "PASS"}`);
console.log(`Required artifacts: ${required.length}; source files scanned: ${sourceFiles.length}`);
for (const error of errors) console.log(`- ${error}`);
if (errors.length) process.exit(1);
