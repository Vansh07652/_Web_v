{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curriculum-subject-v2.schema.json",
  "title": "Curriculum subject bundle v2",
  "type": "object",
  "required": ["schemaVersion", "subject", "units", "statistics", "provenance"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "subject": {
      "type": "object",
      "required": ["id", "slug", "title", "aliases", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "order", "topics"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "slug", "title", "order", "bundlePath"],
              "properties": {
                "id": { "type": "string" },
                "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string" },
                "order": { "type": "integer", "minimum": 1 },
                "bundlePath": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "statistics": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
