{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curriculum-crosswalk-v2.schema.json",
  "title": "Curriculum source crosswalk v2",
  "type": "object",
  "required": ["schemaVersion", "subjectSlug", "policy", "sources"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "subjectSlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "policy": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceCollection", "sourceRoot", "mappings"],
        "properties": {
          "sourceCollection": { "type": "string" },
          "sourceRoot": { "type": "string" },
          "mappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sourceTopicId", "sourceTitle"] } }
        }
      }
    }
  },
  "additionalProperties": false
}
