{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "required": [
    "id",
    "subject",
    "lesson",
    "contentType",
    "questionType",
    "question",
    "options",
    "correctAnswer",
    "explanation",
    "difficulty",
    "tags",
    "source",
    "originalFile",
    "status",
    "reviewStatus",
    "humanVerificationRequired"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "subject": {
      "enum": [
        "biology-1",
        "biology-2",
        "organic-chemistry-1",
        "organic-chemistry-2",
        "chemistry-1",
        "chemistry-2",
        "physics-1",
        "physics-2",
        "microbiology",
        "genetics",
        "nclex-review"
      ]
    },
    "lesson": {
      "type": "string"
    },
    "contentType": {
      "const": "question"
    },
    "questionType": {
      "enum": [
        "multiple-choice",
        "multiple-select",
        "true-false",
        "short-answer",
        "fill-in-the-blank",
        "matching",
        "calculation",
        "case-study",
        "NCLEX-style"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "correctAnswer": {
      "type": "string"
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "originalFile": {
      "type": "string"
    },
    "status": {
      "const": "approved"
    },
    "reviewStatus": {
      "const": "audited"
    },
    "humanVerificationRequired": {
      "const": false
    }
  },
  "additionalProperties": false
}
